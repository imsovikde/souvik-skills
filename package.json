{
  "name": "@imsovikde/skills",
  "version": "0.8.0",
  "description": "Souvik Dey's marketplace-ready AI agent skill directory.",
  "license": "MIT",
  "author": "Souvik Dey <https://github.com/imsovikde>",
  "homepage": "https://souvik-skills.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsovikde/souvik-skills.git"
  },
  "bugs": {
    "url": "https://github.com/imsovikde/souvik-skills/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "claude-plugin",
    "plugin-marketplace",
    "agent-skills",
    "skills",
    "ai-agents",
    "github-readiness",
    "repository-readiness",
    "release-automation",
    "seo",
    "github",
    "git",
    "repository-cleanup",
    "motion",
    "music",
    "musicxml",
    "abc-notation",
    "sheet-music",
    "magento",
    "adobe-commerce",
    "ecommerce"
  ],
  "type": "module",
  "bin": {
    "souvik-skills": "bin/souvik-skills.cjs"
  },
  "files": [
    "AGENTS.md",
    "CLAUDE.md",
    "NAMING.md",
    "README.md",
    "LICENSE",
    "guidance.md",
    ".claude-plugin/marketplace.json",
    "codex-plugin.json",
    "bin/souvik-skills.cjs",
    "scripts/validate-skills.cjs",
    "skills/*/SKILL.md",
    "skills/*/.claude-plugin/plugin.json",
    "skills/*/agents/openai.yaml",
    "skills/*/assets/**",
    "skills/*/scripts/**",
    "!skills/*/scripts/**/__pycache__/**",
    "!skills/*/scripts/**/.pytest_cache/**",
    "!skills/*/scripts/**/*.pyc",
    "!skills/*/scripts/**/*.pyo",
    "skills/*/references/**"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "list": "node bin/souvik-skills.cjs list",
    "audit:gh-ready": "node skills/gh-ready/scripts/audit-gh-ready.cjs .",
    "audit:motioncraft": "node skills/motioncraft/scripts/audit-motioncraft.cjs .",
    "test:delink-github": "python skills/delink-github/scripts/test_delink.py",
    "test:score2md": "python skills/score2md/scripts/run_tests.py",
    "test:claude-md-init": "node skills/claude-md-init/scripts/test_init_claude_md.cjs",
    "test:skill-ship": "node skills/skill-ship/scripts/test_preflight.cjs",
    "validate:skills": "node scripts/validate-skills.cjs",
    "test": "npm run validate:skills && npm run test:delink-github && npm run test:score2md && npm run test:claude-md-init && npm run test:skill-ship && npm run audit:ars",
    "audit:ars": "node skills/ars/scripts/audit-ars.cjs ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serve": "^14.2.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
